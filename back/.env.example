# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 커밋하지 않는다.
DB_USERNAME=
DB_PASSWORD=

# 소셜 로그인 (FR-018). 카카오·네이버 개발자 콘솔에서 발급
# Redirect URI: {서비스 주소}/login/oauth2/code/kakao, {서비스 주소}/login/oauth2/code/naver
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT 서명 키 (32바이트 이상 임의 문자열)
JWT_SECRET=

# 파일 저장소 (FR-008). S3 버킷과 이미지를 내려줄 주소(CloudFront 도메인)
# 로컬은 IAM 사용자 키, 운영은 IAM 역할로 자격 증명을 준다
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
