# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 커밋하지 않는다.
DB_USERNAME=
DB_PASSWORD=

# 소셜 로그인 (FR-018). 카카오·네이버 개발자 콘솔에서 발급
# Redirect URI: {서비스 주소}/login/oauth2/code/kakao, {서비스 주소}/login/oauth2/code/naver
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# JWT 서명 키 (32바이트 이상 임의 문자열)
JWT_SECRET=
